// TPT Packager on Cloudflare. Cloudflare reads this file when it deploys the project.
{
  "name": "tpt-packager",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // The page and its scripts in site/ come straight from Cloudflare's edge.
  // Anything that isn't a file there (only /api/google-export) goes to src/worker.js.
  "assets": { "directory": "./site", "binding": "ASSETS" },
  "observability": { "enabled": true }
}
